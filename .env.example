# Reuse the existing Render secret; do not paste its value into chat or source.
OPENAI_API_KEY=
# The same model already used by the existing text assistant.
ASSESSMENT_MODEL=gpt-5.4-nano
# Optional switch. false keeps the assessment entirely rules-based.
ASSESSMENT_AI_ENABLED=true
# Render provides RENDER_EXTERNAL_URL. Override only with a verified same-origin URL.
# ASSESSMENT_ORIGIN=https://fc-ai-assistant.onrender.com
# Local testing only; keep Render's existing PORT and binding behavior.
# HOST=127.0.0.1
# PORT=4319
